---
import { languages } from '../i18n/ui'
import { getLangFromUrl } from '../i18n/utils';
import cn from '../utils/cn';
const url = Astro.url;
const currentLanguage = getLangFromUrl(url);
const path = url.pathname.split('/').length > 3 ? url.pathname.split('/').slice(-2, -1) : '';
---

<nav 
    id="mobile-language-dropdown"
    class="mobile-language-picker w-full p-4 bg-transparent flex justify-center gap-3 mb-2"
    aria-label="Language selection">
    {Object.entries(languages).map(([code, name]) => (
        <a 
            href={import.meta.env.SITE + `${code}/${path}`}
            class={cn(
                "flex flex-col items-center gap-1 px-3 py-2 rounded-lg transition-all hover:bg-secondary/20",
                code === currentLanguage ? 'bg-secondary text-white' : 'bg-input'
            )}
            data-lang={code}
            aria-label={`Switch to ${name}`}>
            <img 
                src={`/${code.split('-')[0]}.webp`} 
                alt="" 
                class="w-8 h-8 rounded-full shadow-sm"
                aria-hidden="true"
                width="32"
                height="32"
                loading="lazy"
            />
            <span class="text-xs font-medium">{name.slice(0,2).toUpperCase()}</span>
        </a>
    ))}
</nav>